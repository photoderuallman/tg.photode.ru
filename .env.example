APP_ENV=development
VPN_INTERFACE=tg-vpn

# Leave empty until the server VPN is active and we choose the TDLib probe.
TELEGRAM_PROBE_HOST=
TELEGRAM_PROBE_PORT=443

# disabled locks authorization; mock simulates it; tdlib uses the native client.
TELEGRAM_AUTH_MODE=mock
TELEGRAM_MOCK_REQUIRE_PASSWORD=true

# Required only for tdlib mode. Never commit real values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TDLIB_DATABASE_DIRECTORY=storage/tdlib
TDLIB_FILES_DIRECTORY=storage/tdlib/files
TDLIB_DATABASE_ENCRYPTION_KEY=
# Optional explicit path when libtdjson isn't discoverable through the system loader.
TDLIB_LIBRARY_PATH=
