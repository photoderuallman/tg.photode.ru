[Unit]
Description=Run an immediate deep Telegram VPN check requested by the iPhone app
After=network-online.target xray.service sing-box.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/rm -f /run/tg-vpn-app-check/request
ExecStart=/usr/local/libexec/tg-vpn-failover --force-deep
ExecStopPost=/usr/local/libexec/tg-vpn-failover --ensure-transport
TimeoutStartSec=300
StateDirectory=tg-vpn-failover
RuntimeDirectory=tg-vpn-failover
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/usr/local/etc/xray /var/lib/tg-vpn-failover /run/tg-vpn-failover /run/tg-vpn-app-check
