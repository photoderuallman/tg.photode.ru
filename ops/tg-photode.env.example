APP_ENV=production
VPN_INTERFACE=tg-vpn
TELEGRAM_PROBE_HOST=149.154.167.50
TELEGRAM_PROBE_PORT=443
TELEGRAM_AUTH_MODE=tdlib
TELEGRAM_MOCK_REQUIRE_PASSWORD=true

# Populate only in /etc/tg-photode/tg-photode.env on the VPS.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TDLIB_DATABASE_DIRECTORY=/var/lib/tg-photode/tdlib
TDLIB_FILES_DIRECTORY=/var/lib/tg-photode/tdlib/files
TDLIB_DATABASE_ENCRYPTION_KEY=
TDLIB_LIBRARY_PATH=
