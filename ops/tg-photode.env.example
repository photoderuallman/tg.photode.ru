APP_ENV=production
VPN_INTERFACE=tg-vpn
TELEGRAM_PROBE_HOST=149.154.167.50
TELEGRAM_PROBE_PORT=443
TELEGRAM_AUTH_MODE=tdlib
TELEGRAM_MOCK_REQUIRE_PASSWORD=true

# Optional multi-account phone/code login for the native iPhone client. Each device
# receives an isolated encrypted TDLib database. Keep the session count low on a
# 1 GB VPS and increase only after measuring memory usage.
TELEGRAM_MULTI_ACCOUNT_ENABLED=false
TELEGRAM_MAX_ACCOUNT_SESSIONS=3
TELEGRAM_LOGIN_FLOW_TTL_SECONDS=600
TELEGRAM_ACCOUNT_SESSION_TTL_SECONDS=2592000
TELEGRAM_ACCOUNT_TOKEN_SECRET=

# Permanent single-account native build. This bearer routes the signed iPhone app to
# the already-authorized global TDLib session. Rotate it and rebuild if the device or
# application bundle is lost.
IOS_DEVICE_ACCESS_TOKEN=

# Populate only in /etc/tg-photode/tg-photode.env on the VPS.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TDLIB_DATABASE_DIRECTORY=/var/lib/tg-photode/tdlib
TDLIB_FILES_DIRECTORY=/var/lib/tg-photode/tdlib/files
TDLIB_ACCOUNTS_DIRECTORY=/var/lib/tg-photode/accounts
TDLIB_DATABASE_ENCRYPTION_KEY=
TDLIB_LIBRARY_PATH=
MEDIA_UPLOAD_MAX_BYTES=104857600
MEDIA_FFMPEG_PATH=/usr/bin/ffmpeg

# Website access is separate from Telegram authorization. The fragment-based private
# link exchanges WEB_ACCESS_KEY for a signed browser session without exposing TDLib.
WEB_AUTH_REQUIRED=true
WEB_ACCESS_KEY=
WEB_SESSION_SECRET=
WEB_SESSION_TTL_SECONDS=2592000
WEB_ALLOWED_ORIGINS=https://photode.ru,https://www.photode.ru
